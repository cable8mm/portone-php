{
    "name": "cable8mm/portone-php",
    "description": "PortOne V2 server SDK for PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^8.0"
    },
    "require-dev": {
        "vlucas/phpdotenv": "^5.6",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.29"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "serve": "php -S 127.0.0.1:8080 -t samples samples/index.php",
        "e2e": "php tools/run_e2e.php"
    },
    "autoload": {
        "psr-4": {
            "Cable8mm\\PortonePhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cable8mm\\PortonePhp\\Tests\\": "tests/"
        }
    }
}
