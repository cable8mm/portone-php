PORTONE_API_SECRET=your-portone-api-secret
PORTONE_WEBHOOK_SECRET=whsec_your-portone-webhook-secret

# Required by the live payment lifecycle probe.
PORTONE_E2E_CHANNEL_KEY=your-test-channel-key
PORTONE_E2E_CARD_NUMBER=your-test-card-number
PORTONE_E2E_CARD_EXPIRY_YEAR=25
PORTONE_E2E_CARD_EXPIRY_MONTH=12
PORTONE_E2E_BIRTH_OR_BUSINESS_NUMBER=your-6-digit-birth-or-10-digit-business-number
PORTONE_E2E_PASSWORD_TWO_DIGITS=00

# Optional when the API secret has access to more than one store.
PORTONE_E2E_STORE_ID=your-test-store-id
